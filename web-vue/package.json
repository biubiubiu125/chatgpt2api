    "postcss": "^8.5.26",
    "tailwindcss": "^3.4.19",
    "typescript": "~5.9.3",
    "vite": "^7.3.6"
  },
  "dependencies": {
    "@vitejs/plugin-vue": "^6.0.6",
    "axios": "^1.19.0",
    "highlight.js": "^11.11.1",
    "js-beautify": "^1.15.4",
    "markdown-it": "^14.2.0",
    "nanocat-ui": "^0.1.6",
    "pinia": "^3.0.4",
