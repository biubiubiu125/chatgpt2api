    "test:register-provider": "node scripts/test-register-provider-view.mjs",
    "test:studio-image-tasks": "node scripts/test-studio-image-task-closed-loop.mjs && node scripts/test-studio-image-task-runtime.mjs",
    "test:third-party-links": "node scripts/test-third-party-links.mjs && node scripts/test-safe-external-url.mjs",
    "preview": "vite preview"
  },
  "devDependencies": {
    "@iconify/vue": "^5.0.0",
    "@types/js-beautify": "^1.14.3",
    "@types/markdown-it": "^14.1.2",
