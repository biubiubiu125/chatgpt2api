# ============================================
# ChatGPT2API 环境变量配置示例
# ============================================

# 认证密钥（必填）
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
CHATGPT2API_AUTH_KEY=

# Web / API 暴露端口
CHATGPT2API_PORT=3000

# 后端同步线程池容量；实时监控显示入口线程等待时可适当调高。
CHATGPT2API_THREAD_TOKENS=80

# Docker 镜像；main/latest 由 GitHub Actions 自动构建并推送到 GHCR
# 也可固定为具体 v* release tag
CHATGPT2API_IMAGE=ghcr.io/biubiubiu125/chatgpt2api:latest

# 基础 URL（可选，用于生成图片 URL）
# CHATGPT2API_BASE_URL=https://your-domain.com

# ============================================
# 集群角色配置
# ============================================

# standalone：单机；api-main：主节点；worker：从节点
CHATGPT2API_NODE_ROLE=standalone
# 留空时按角色自动决定；api-main 默认只跑 API，worker 默认只跑 Worker
# CHATGPT2API_RUN_API=true
# CHATGPT2API_RUN_WORKER=true
# 从节点编号，例如 worker-1、worker-2
# CHATGPT2API_WORKER_ID=worker-1
# 从节点 WireGuard 内网 IP，例如 10.77.0.11
# CHATGPT2API_WIREGUARD_IP=10.77.0.11
# 从节点公开图片 URL，必须能公网访问 /images
# CHATGPT2API_IMAGE_BASE_URL=https://img-1.example.com/images
# CHATGPT2API_CLUSTER_ID=cluster-xxxxxxxxxxxxxxxx
# 从节点安装成功标记，容器内默认路径；脚本会在消费 join token 后写入
# CHATGPT2API_WORKER_JOINED_MARKER_FILE=/app/data/worker.joined
# 从节点本地图片服务端口
# CHATGPT2API_IMAGE_PORT=3000
# WireGuard 主节点公网 IP/域名
# WIREGUARD_SERVER_ENDPOINT=main.example.com

# 主库与队列库建议固定库名，避免填反
# APP_DATABASE_URL=postgresql://chatgpt2api_runtime:password@10.77.0.1:5432/chatgpt2api_app
# IMAGE_QUEUE_DATABASE_URL=postgresql://chatgpt2api_runtime:password@10.77.0.1:5432/chatgpt2api_image_queue
# 仅主节点 PostgreSQL 初始化使用；不要写入 worker.join 文件或 worker 节点环境
# POSTGRES_ADMIN_USER=chatgpt2api_admin
# POSTGRES_ADMIN_PASSWORD=main-node-only-admin-password
# POSTGRES_PASSWORD=runtime-password
# POSTGRES_PASSWORD_URLENCODED=runtime-password-urlencoded

# ============================================
# 存储后端配置
# ============================================

# 存储后端类型（可选值: json, sqlite, postgres, git）
# 默认: json
STORAGE_BACKEND=json

# 持久生图队列专用 PostgreSQL。标准/WARP Compose 会在此项缺失时拒绝启动，避免图片接口上线后返回 503。
# IMAGE_QUEUE_DATABASE_URL=postgresql+psycopg2://user:password@postgres-host:5432/chatgpt2api_image_queue
# 是否追加只返回最终图片的提示词后缀；留空时使用内置中文后缀。
# IMAGE_PROMPT_SUFFIX_ENABLED=true
# IMAGE_PROMPT_SUFFIX=
# 原恢复账号不可用时最多等待 900 秒，之后任务明确失败，避免永久卡住。
# IMAGE_QUEUE_RECOVERY_ACCOUNT_TIMEOUT_SECONDS=900
# 标准 OpenAI 协议无法显式 ACK 时，结果至少保护 7 天，可用同一幂等键重新获取。
# IMAGE_QUEUE_DELIVERY_GRACE_SECONDS=604800
# 已尝试投递或已确认的终态任务默认保留 30 天；从未尝试投递的成功结果不会自动清理。
# IMAGE_QUEUE_TERMINAL_RETENTION_SECONDS=2592000
# PostgreSQL 冷启动不可用时每 5 秒自动重连，期间所有本地图片禁止清理。
# IMAGE_QUEUE_STARTUP_RETRY_SECONDS=5
# 标准 OpenAI 协议最多等待 300 秒；超时会返回 task_id，后台任务继续执行。
# IMAGE_QUEUE_PROTOCOL_WAIT_TIMEOUT_SECONDS=300
# 主节点返回 NewAPI 前校验 Worker 节点图片 URL；打不开则任务失败。
# IMAGE_QUEUE_VERIFY_RETURNED_URL=true
# IMAGE_QUEUE_RETURNED_URL_VERIFY_TIMEOUT_SECONDS=5
# IMAGE_QUEUE_RETURNED_URL_VERIFY_ATTEMPTS=3
# IMAGE_QUEUE_RETURNED_URL_VERIFY_MAX_BYTES=65536
# 图片生成放行上限，默认 16；硬上限默认 64，到上限后新任务仍会排队，直到 Worker 放行。
# IMAGE_QUEUE_GENERATION_CONCURRENCY=16
# IMAGE_QUEUE_GENERATION_CONCURRENCY_CAP=64
# IMAGE_QUEUE_ABSOLUTE_GUARD=128
# 持久队列最多允许等待 50 单，防止无限堆积。
# IMAGE_QUEUE_MAX_BACKLOG=50
# 单个任务在队列里最多等待 60 秒，超时后标记失败。
# IMAGE_QUEUE_PENDING_TTL_SECONDS=1800
# IMAGE_QUEUE_CLAIM_MAX_RUNTIME_SECONDS=1800

# ============================================
# 数据库配置（当 STORAGE_BACKEND=sqlite/postgres 时使用）
# ============================================

# PostgreSQL 示例
# DATABASE_URL=postgresql://user:password@localhost:5432/chatgpt2api

# Supabase 示例
# DATABASE_URL=postgresql://postgres.xxx:password@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# SQLite 示例（不指定时自动使用 data/accounts.db）
# DATABASE_URL=sqlite:////app/data/accounts.db

# ============================================
# Git 仓库配置（当 STORAGE_BACKEND=git 时使用）
# ============================================

# Git 仓库地址（必填）
# GIT_REPO_URL=https://github.com/your-username/your-private-repo.git

# Git 访问令牌（必填）
# GitHub: ghp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# GitLab: glpat-xxxxxxxxxxxxxxxxxxxx
# GIT_TOKEN=your_git_token_here

# Git 分支（可选，默认: main）
# GIT_BRANCH=main

# Git 仓库中的文件路径（可选，默认: accounts.json）
# GIT_FILE_PATH=accounts.json

# Git 仓库中的用户密钥文件路径（可选，默认: auth_keys.json）
# GIT_AUTH_KEYS_FILE_PATH=auth_keys.json

# ============================================
# WARP / FlareSolverr 稳定代理配置（可选）
# ============================================

# docker-compose.warp.yml 暴露到宿主机的端口
# WARP_SOCKS_PORT=40000
# PRIVOXY_PORT=40080
# FLARESOLVERR_PORT=8191

# FlareSolverr 日志与时区
# FLARESOLVERR_LOG_LEVEL=info
# TZ=Asia/Shanghai

# Cloudflare WARP+ License Key（可选）
# WARP_LICENSE_KEY=

# 初始化 proxy_runtime 默认值
# CHATGPT2API_PROXY_RUNTIME_ENABLED=true
# CHATGPT2API_PROXY_RUNTIME_EGRESS_MODE=single_proxy
# CHATGPT2API_PROXY_RUNTIME_PROXY_URL=http://privoxy:8118
# CHATGPT2API_PROXY_RUNTIME_RESOURCE_PROXY_URL=
# CHATGPT2API_PROXY_RUNTIME_SKIP_SSL_VERIFY=false
# CHATGPT2API_PROXY_RUNTIME_RESET_STATUS_CODES=403

# Cloudflare clearance 刷新配置
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_ENABLED=true
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_MODE=flaresolverr
# CHATGPT2API_FLARESOLVERR_URL=http://flaresolverr:8191
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_TIMEOUT_SEC=60
# CHATGPT2API_PROXY_RUNTIME_CLEARANCE_REFRESH_INTERVAL=3600
# CHATGPT2API_PROXY_RUNTIME_WARM_UP_ON_START=false
# CHATGPT2API_PROXY_RUNTIME_BROWSER=chrome
# CHATGPT2API_PROXY_RUNTIME_USER_AGENT=
